{
    "_version": "1.60.0",
    "sap.app": {
        "id": "sapuccino",
        "type": "application",
        "title": "SAPuccino - Coffee Tracker",
        "description": "Frontend SAPUI5 para el hackatón",
        "applicationVersion": {
            "version": "0.0.1"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "sapuccino.view.App",
            "type": "XML",
            "id": "app",
            "async": true
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.layout": {}
            }
        },
        "resources": {
            "css": [
                { "uri": "css/style.css" }
            ]
        },
        "models": {},
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "sapuccino.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },
            "routes": [
                {
                    "name": "monitor",
                    "pattern": "",
                    "target": "monitor"
                },
                {
                    "name": "detalhamento",
                    "pattern": "detalhamento",
                    "target": "detalhamento"
                }
            ],
            "targets": {
                "monitor": {
                    "id": "monitor",
                    "name": "Monitor"
                },
                "detalhamento": {
                    "id": "detalhamento",
                    "name": "Detalhamento"
                }
            }
        }
    }
}
