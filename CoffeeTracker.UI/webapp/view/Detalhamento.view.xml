<mvc:View
    controllerName="sapuccino.controller.Detalhamento"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:micro="sap.suite.ui.microchart"
    displayBlock="true"
    height="100%">
    <Page id="detalhamentoPage" showHeader="false" class="sapuccinoApp">
        <content>
            <!-- Cabeçalho verde, no mesmo estilo do Monitor. -->
            <VBox class="detHeader">
                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                    <HBox alignItems="Center">
                        <Button icon="sap-icon://nav-back" type="Transparent" press="onBack" class="heroBtn sapUiTinyMarginEnd"/>
                        <Image
                            src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%208h12v5a4%204%200%200%201-4%204H8a4%204%200%200%201-4-4z%22%2F%3E%3Cpath%20d%3D%22M16%209h2.5a2.5%202.5%200%200%201%200%205H16%22%2F%3E%3Cpath%20d%3D%22M7%202.5v2M10%202v2.5M13%202.5v2%22%2F%3E%3C%2Fsvg%3E"
                            width="1.6rem"
                            height="1.6rem"
                            class="sapUiTinyMarginEnd"/>
                        <Text text="SAPUCCINO" class="brandTitle"/>
                    </HBox>
                </HBox>
                <VBox alignItems="Center" width="100%" class="sapUiSmallMarginTop">
                    <Text text="DETALHAMENTO" class="detTitle"/>
                    <Text text="Relatórios de consumo e disponibilidade" class="detSubtitle"/>
                </VBox>
            </VBox>

            <!-- KPIs do período. -->
            <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMargin">
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%208h12v5a4%204%200%200%201-4%204H8a4%204%200%200%201-4-4z%22%2F%3E%3Cpath%20d%3D%22M16%209h2.5a2.5%202.5%200%200%201%200%205H16%22%2F%3E%3Cpath%20d%3D%22M7%202.5v2M10%202v2.5M13%202.5v2%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="TOTAL NO PERÍODO" class="kpiLabel"/>
                            <Text text="{/totalCoffees}" class="kpiNumberSm"/>
                            <Text text="cafés" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2017L9%2011L13%2014L21%206%22%2F%3E%3Cpath%20d%3D%22M16%206h5v5%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="MÉDIA POR DIA" class="kpiLabel"/>
                            <Text text="{/averagePerDay}" class="kpiNumberSm"/>
                            <Text text="cafés/dia" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%224.5%22%20width%3D%2218%22%20height%3D%2216%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M3%209h18M8%202.5v4M16%202.5v4%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="DIA MAIS ATIVO" class="kpiLabel"/>
                            <Text text="{/busiestDayText}" class="kpiNumberSm"/>
                            <Text text="{/busiestDayCaption}" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2013h3l3-7%204%2013%203-9%202%203h3%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="HORÁRIO DE PICO" class="kpiLabel"/>
                            <Text text="{/peakHourText}" class="kpiNumberSm"/>
                            <Text text="no período" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
            </l:Grid>

            <!-- Gráfico: cafés por dia. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                        <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2021V5M3%2021h18%22%2F%3E%3Crect%20x%3D%226%22%20y%3D%2212%22%20width%3D%223%22%20height%3D%226%22%2F%3E%3Crect%20x%3D%2211%22%20y%3D%228%22%20width%3D%223%22%20height%3D%2210%22%2F%3E%3Crect%20x%3D%2216%22%20y%3D%2214%22%20width%3D%223%22%20height%3D%224%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                    </VBox>
                    <Text text="CAFÉS POR DIA" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <HBox class="colChartFlex sapUiTinyMarginTop" items="{/daily}">
                    <VBox class="colItemFlex" alignItems="Center" justifyContent="End">
                        <Text text="{value}" class="colValueXs"/>
                        <VBox class="colBarArea colBarAreaFlex" justifyContent="End">
                            <VBox class="colBar" height="{height}"/>
                        </VBox>
                        <Text text="{label}" class="colLabelXs"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Filtro de ano (fora do cartão), à direita. -->
            <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
                <Text text="Ano" class="yearLabel sapUiTinyMarginEnd"/>
                <SegmentedButton class="yearTabs" selectedKey="{/selectedYear}" selectionChange="onYearChange" items="{/monthlyYears}">
                    <items>
                        <SegmentedButtonItem key="{key}" text="{text}"/>
                    </items>
                </SegmentedButton>
            </HBox>

            <!-- Gráfico: cafés por mês. -->
            <VBox class="kpiCard sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                        <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%224.5%22%20width%3D%2218%22%20height%3D%2216%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M3%209h18M8%202.5v4M16%202.5v4%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                    </VBox>
                    <Text text="CAFÉS POR MÊS" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <HBox class="colChartFlex sapUiTinyMarginTop" items="{/monthly}">
                    <VBox class="colItemFlex" alignItems="Center" justifyContent="End">
                        <Text text="{value}" class="colValueXs"/>
                        <VBox class="colBarArea colBarAreaFlex" justifyContent="End">
                            <VBox class="colBar" height="{height}"/>
                        </VBox>
                        <Text text="{label}" class="colLabelXs"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Gráfico: distribuição por hora. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                        <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M12%207v5l3%202%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                    </VBox>
                    <Text text="DISTRIBUIÇÃO POR HORA" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <Text text="Consumo ao longo do dia — a linha sobe nas horas com mais cafés." class="kpiCaption"/>
                <micro:LineMicroChart
                    size="Responsive"
                    width="100%"
                    height="7rem"
                    color="#16a34a"
                    points="{/hourlyPoints}"
                    class="hourLineChart sapUiTinyMarginTop">
                    <micro:points>
                        <micro:LineMicroChartPoint x="{x}" y="{y}"/>
                    </micro:points>
                </micro:LineMicroChart>
                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
                    <Text text="0h" class="kpiCaption"/>
                    <Text text="6h" class="kpiCaption"/>
                    <Text text="12h" class="kpiCaption"/>
                    <Text text="18h" class="kpiCaption"/>
                    <Text text="23h" class="kpiCaption"/>
                </HBox>
            </VBox>

            <!-- Horários de pico: as 3 horas com mais cafés. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <VBox class="kpiIconSm kpiIconOrange" justifyContent="Center" alignItems="Center">
                        <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23f97316%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2013h3l3-7%204%2013%203-9%202%203h3%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                    </VBox>
                    <Text text="HORÁRIOS DE PICO" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <HBox alignItems="Stretch" wrap="Wrap" items="{/peakHours}">
                    <HBox class="kpiCol" alignItems="Center">
                        <Text text="{rank}" class="peakRank"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="{hour}" class="kpiNumberSm"/>
                            <Text text="{countText}" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </HBox>
            </VBox>

            <!-- Disponibilidade / uptime. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                        <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M8.5%2012.5l2.5%202.5%204.5-5%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                    </VBox>
                    <Text text="DISPONIBILIDADE" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <HBox alignItems="End" wrap="Wrap" class="sapUiSmallMarginTop">
                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <VBox height="5.5rem" width="5.5rem" renderType="Bare" class="chartFill">
                            <micro:RadialMicroChart size="Responsive" percentage="{/uptimePercent}" valueColor="Good"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="uptime no período" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                    <VBox class="sapUiLargeMarginEnd">
                        <Text text="{/currentStateText}" class="kpiNumberSm"/>
                        <Text text="estado atual" class="kpiCaption"/>
                    </VBox>
                    <VBox class="sapUiLargeMarginEnd">
                        <Text text="{/outages}" class="kpiNumberSm"/>
                        <Text text="quedas" class="kpiCaption"/>
                    </VBox>
                    <VBox>
                        <Text text="{/longestOutageText}" class="kpiNumberSm"/>
                        <Text text="maior queda" class="kpiCaption"/>
                    </VBox>
                </HBox>
            </VBox>

            <Text
                text="Sistema SAPUCCINO • Relatórios de consumo e disponibilidade"
                textAlign="Center"
                width="100%"
                class="kpiCaption sapUiSmallMarginBottom"/>
        </content>
    </Page>
</mvc:View>
