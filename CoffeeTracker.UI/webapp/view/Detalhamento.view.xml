<mvc:View
    controllerName="sapuccino.controller.Detalhamento"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    height="100%">
    <Page id="detalhamentoPage" showHeader="false" class="sapuccinoApp">
        <content>
            <!-- Cabeçalho verde, no mesmo estilo do Monitor. -->
            <VBox class="detHeader">
                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                    <HBox alignItems="Center">
                        <Button icon="sap-icon://nav-back" type="Transparent" press="onBack" class="heroBtn sapUiTinyMarginEnd"/>
                        <Image
                            src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%208h12v5a4%204%200%200%201-4%204H8a4%204%200%200%201-4-4z%22%2F%3E%3Cpath%20d%3D%22M16%209h2.5a2.5%202.5%200%200%201%200%205H16%22%2F%3E%3Cpath%20d%3D%22M7%202.5v2M10%202v2.5M13%202.5v2%22%2F%3E%3C%2Fsvg%3E"
                            width="1.6rem"
                            height="1.6rem"
                            class="sapUiTinyMarginEnd"/>
                        <Text text="SAPUCCINO" class="brandTitle"/>
                    </HBox>
                    <SegmentedButton selectedKey="{/periodDays}" selectionChange="onPeriodChange">
                        <items>
                            <SegmentedButtonItem text="7 dias" key="7"/>
                            <SegmentedButtonItem text="30 dias" key="30"/>
                            <SegmentedButtonItem text="90 dias" key="90"/>
                        </items>
                    </SegmentedButton>
                </HBox>
                <VBox alignItems="Center" width="100%" class="sapUiSmallMarginTop">
                    <Text text="DETALHAMENTO" class="detTitle"/>
                    <Text text="Relatórios de consumo e disponibilidade" class="detSubtitle"/>
                </VBox>
            </VBox>

            <!-- KPIs do período. -->
            <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMargin">
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%208h12v5a4%204%200%200%201-4%204H8a4%204%200%200%201-4-4z%22%2F%3E%3Cpath%20d%3D%22M16%209h2.5a2.5%202.5%200%200%201%200%205H16%22%2F%3E%3Cpath%20d%3D%22M7%202.5v2M10%202v2.5M13%202.5v2%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="TOTAL NO PERÍODO" class="kpiLabel"/>
                            <Text text="{/totalCoffees}" class="kpiNumberSm"/>
                            <Text text="cafés" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2017L9%2011L13%2014L21%206%22%2F%3E%3Cpath%20d%3D%22M16%206h5v5%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="MÉDIA POR DIA" class="kpiLabel"/>
                            <Text text="{/averagePerDay}" class="kpiNumberSm"/>
                            <Text text="cafés/dia" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%224.5%22%20width%3D%2218%22%20height%3D%2216%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M3%209h18M8%202.5v4M16%202.5v4%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="DIA MAIS ATIVO" class="kpiLabel"/>
                            <Text text="{/busiestDayText}" class="kpiNumberSm"/>
                            <Text text="{/busiestDayCaption}" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <VBox class="kpiIconSm kpiIconGreen" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2013h3l3-7%204%2013%203-9%202%203h3%22%2F%3E%3C%2Fsvg%3E" width="1.2rem" height="1.2rem"/>
                        </VBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="HORÁRIO DE PICO" class="kpiLabel"/>
                            <Text text="{/peakHourText}" class="kpiNumberSm"/>
                            <Text text="no período" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
            </l:Grid>

            <!-- Gráfico: cafés por dia. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <Text text="📊" class="kpiIconSm kpiIconBlue"/>
                    <Text text="CAFÉS POR DIA" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <List
                    items="{/daily}"
                    noDataText="Sem dados no período."
                    showSeparators="None">
                    <CustomListItem>
                        <HBox alignItems="Center" class="sapUiTinyMarginTopBottom">
                            <Text text="{label}" width="5rem" class="barLabel"/>
                            <ProgressIndicator
                                percentValue="{percent}"
                                displayValue="{value}"
                                showValue="true"
                                state="Information"
                                class="sapUiSmallMarginBegin"
                                width="100%"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- Gráfico: distribuição por hora. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <Text text="🕐" class="kpiIconSm kpiIconGreen"/>
                    <Text text="DISTRIBUIÇÃO POR HORA" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <List
                    items="{/hourly}"
                    noDataText="Sem dados no período."
                    showSeparators="None">
                    <CustomListItem>
                        <HBox alignItems="Center" class="sapUiTinyMarginTopBottom">
                            <Text text="{label}" width="3.5rem" class="barLabel"/>
                            <ProgressIndicator
                                percentValue="{percent}"
                                displayValue="{value}"
                                showValue="true"
                                state="Success"
                                class="sapUiSmallMarginBegin"
                                width="100%"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- Disponibilidade / uptime. -->
            <VBox class="kpiCard sapUiSmallMargin">
                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <Text text="🟢" class="kpiIconSm kpiIconGreen"/>
                    <Text text="DISPONIBILIDADE" class="sectionTitle sapUiSmallMarginBegin"/>
                </HBox>
                <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1">
                    <VBox>
                        <Text text="{/uptimePercent}%" class="kpiNumberGreen"/>
                        <Text text="uptime no período" class="kpiCaption"/>
                    </VBox>
                    <VBox>
                        <Text text="{/currentStateText}" class="kpiNumberSm"/>
                        <Text text="estado atual" class="kpiCaption"/>
                    </VBox>
                    <VBox>
                        <Text text="{/outages}" class="kpiNumberSm"/>
                        <Text text="quedas" class="kpiCaption"/>
                    </VBox>
                    <VBox>
                        <Text text="{/longestOutageText}" class="kpiNumberSm"/>
                        <Text text="maior queda" class="kpiCaption"/>
                    </VBox>
                </l:Grid>
            </VBox>

            <Text
                text="Sistema SAPUCCINO • Relatórios de consumo e disponibilidade"
                textAlign="Center"
                width="100%"
                class="kpiCaption sapUiSmallMarginBottom"/>
        </content>
    </Page>
</mvc:View>
