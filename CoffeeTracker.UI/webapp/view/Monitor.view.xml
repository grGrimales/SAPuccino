<mvc:View
    controllerName="sapuccino.controller.Monitor"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">
    <Page id="monitorPage" showHeader="false" class="sapuccinoApp">
        <content>
            <!-- Faixa de estado (cor muda conforme online/em uso/offline);
                 inclui o cabeçalho da marca, como na imagem de referência. -->
            <VBox id="heroBanner" class="heroBanner">
                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                    <VBox>
                        <HBox alignItems="Center">
                            <Image
                                src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%208h12v5a4%204%200%200%201-4%204H8a4%204%200%200%201-4-4z%22%2F%3E%3Cpath%20d%3D%22M16%209h2.5a2.5%202.5%200%200%201%200%205H16%22%2F%3E%3Cpath%20d%3D%22M7%202.5v2M10%202v2.5M13%202.5v2%22%2F%3E%3C%2Fsvg%3E"
                                width="1.7rem"
                                height="1.7rem"
                                class="sapUiTinyMarginEnd"/>
                            <Text text="SAPUCCINO" class="brandTitle"/>
                        </HBox>
                        <Text text="{/connectionText}" class="heroBrandSub"/>
                    </VBox>
                    <Button
                        text="Detalhamento"
                        icon="sap-icon://line-chart"
                        type="Transparent"
                        press="onOpenDetalhamento"
                        class="heroBtn"/>
                </HBox>
                <VBox alignItems="Center" width="100%" class="sapUiSmallMarginTop">
                    <Text text="{/heroIcon}" class="heroIcon"/>
                    <Text text="{/heroState}" class="heroState"/>
                    <Text text="{/heroSubtitle}" class="heroSubtitle"/>
                </VBox>
            </VBox>

            <!-- Três cartões principais (mesmo tamanho: largura e altura iguais). -->
            <HBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop" alignItems="Stretch" justifyContent="SpaceBetween" wrap="Wrap">
                <!-- Cafés hoje -->
                <VBox class="kpiCard cardThird">
                    <VBox class="cardTopRel">
                        <VBox class="kpiIcon accentSoftBg cardIconAbs" justifyContent="Center" alignItems="Center">
                            <core:HTML content="&lt;span class=&quot;maskIcon maskCup&quot;&gt;&lt;/span&gt;"/>
                        </VBox>
                        <VBox alignItems="Center" width="100%">
                            <Text text="CAFÉS HOJE" class="kpiLabel"/>
                            <Text text="{/coffeesToday}" class="kpiNumber"/>
                            <Text text="Total preparados" class="kpiCaption"/>
                        </VBox>
                    </VBox>
                    <VBox class="cardSpacer"/>
                    <HBox class="trendPill sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="{/changeText}" class="accentText"/>
                        <core:HTML content="&lt;span class=&quot;maskIcon maskTrend&quot;&gt;&lt;/span&gt;"/>
                    </HBox>
                </VBox>

                <!-- Último café -->
                <VBox class="kpiCard cardThird">
                    <VBox class="cardTopRel">
                        <VBox class="kpiIcon kpiIconGreen cardIconAbs" justifyContent="Center" alignItems="Center">
                            <Image src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2316a34a%22%20stroke-width%3D%221.7%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%2012a9%209%200%201%200%203-6.7L3%208%22%2F%3E%3Cpath%20d%3D%22M3%204v4h4%22%2F%3E%3Cpath%20d%3D%22M12%207v5l3%202%22%2F%3E%3C%2Fsvg%3E" width="1.6rem" height="1.6rem"/>
                        </VBox>
                        <VBox alignItems="Center" width="100%">
                            <Text text="ÚLTIMO CAFÉ" class="kpiLabel"/>
                            <Text text="{/lastUsedDate}" class="kpiNumberSm"/>
                            <Text text="{/lastUsedTime}" class="kpiCaption"/>
                        </VBox>
                    </VBox>
                    <VBox class="cardSpacer"/>
                    <HBox class="statusPill sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="{/lastStatusText}" class="kpiUp"/>
                        <Text text="›" class="kpiCaption"/>
                    </HBox>
                </VBox>

                <!-- Agora -->
                <VBox class="kpiCard cardThird">
                    <HBox alignItems="Center" justifyContent="Center">
                        <core:HTML content="&lt;div class=&quot;clockFace&quot;&gt;&lt;div class=&quot;hand hourHand&quot;&gt;&lt;/div&gt;&lt;div class=&quot;hand minuteHand&quot;&gt;&lt;/div&gt;&lt;div class=&quot;hand secondHand&quot;&gt;&lt;/div&gt;&lt;div class=&quot;clockCenter&quot;&gt;&lt;/div&gt;&lt;/div&gt;"/>
                        <VBox class="sapUiSmallMarginBegin" alignItems="Center">
                            <Text text="AGORA" class="kpiLabel"/>
                            <Text text="{/clockTime}" class="kpiNumberSm"/>
                            <Text text="{/clockDate}" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                    <VBox class="cardSpacer"/>
                    <HBox class="sapUiSmallMarginTop" justifyContent="Center" alignItems="Center">
                        <HBox class="activeBtn" alignItems="Center">
                            <Text text="{/systemActiveText}" class="activeBtnText"/>
                        </HBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- KPIs secundários (apenas dados reais do backend). -->
            <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginBeginEnd">
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <Text text="☕" class="kpiIconSm kpiIconRed"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="TOTAL DO DIA" class="kpiLabel"/>
                            <Text text="{/coffeesToday}" class="kpiNumberSm"/>
                            <Text text="cafés" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <Text text="📈" class="kpiIconSm kpiIconGreen"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="MÉDIA HORÁRIA" class="kpiLabel"/>
                            <Text text="{/averagePerHour}" class="kpiNumberSm"/>
                            <Text text="cafés/hora" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <Text text="⏱️" class="kpiIconSm kpiIconAmber"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="INTERVALO MÉDIO" class="kpiLabel"/>
                            <Text text="{/averageIntervalText}" class="kpiNumberSm"/>
                            <Text text="entre cafés" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox class="kpiCard">
                    <HBox alignItems="Center">
                        <Text text="🔥" class="kpiIconSm kpiIconOrange"/>
                        <VBox class="sapUiSmallMarginBegin">
                            <Text text="HORÁRIO DE PICO" class="kpiLabel"/>
                            <Text text="{/peakHourText}" class="kpiNumberSm"/>
                            <Text text="hoje" class="kpiCaption"/>
                        </VBox>
                    </HBox>
                </VBox>
            </l:Grid>

            <!-- Últimos cafés (somente horários; a máquina não informa o tipo). -->
            <VBox class="kpiCard sapUiSmallMargin">
                <Text text="ÚLTIMOS CAFÉS" class="kpiLabel sapUiTinyMarginBottom"/>
                <List
                    items="{/recentEvents}"
                    noDataText="Ainda não há cafés registrados hoje."
                    showSeparators="Inner">
                    <StandardListItem
                        title="{time}"
                        description="Café detectado"
                        icon="sap-icon://meal"/>
                </List>
            </VBox>

            <Text
                text="Sistema SAPUCCINO • Monitor de operação em tempo real"
                textAlign="Center"
                width="100%"
                class="kpiCaption sapUiSmallMarginBottom"/>
        </content>
    </Page>
</mvc:View>
